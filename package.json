{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "fix": "ultracite fix",
    "up": "pnpm dlx taze major -I -r",
    "react-doctor": "npx -y react-doctor@latest .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "turbo": "^2.7.1",
    "typescript": "5.9.2",
    "ultracite": "7.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3"
}
