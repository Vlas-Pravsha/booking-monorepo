  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.4",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.2",
    "dotenv": "^17.3.1",
    "hono": "^4.12.5",
    "jose": "^6.1.0",
    "pino": "^9.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
